{
  "name": "x-answerer-service",
  "version": "1.0.0",
  "private": true,
  "description": "X Answerer Service",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 3000",
    "build": "react-router build",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "prisma:generate": "prisma generate",
    "prisma:studio": "node --env-file-if-exists=.env node_modules/prisma/build/index.js studio",
    "db:push": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "pnpm db:push && pnpm db:seed"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@react-router/node": "^7.9.0",
    "@react-router/serve": "^7.9.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "isbot": "^5.1.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.469.0",
    "nodemailer": "^6.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.9.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@react-router/dev": "^7.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=22.9.0",
    "pnpm": ">=9.0.0"
  }
}
